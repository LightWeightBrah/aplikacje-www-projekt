<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#2456D6"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Połącz telefon z Solid CRM"
            android:textColor="#1D1B24"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/pair_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adres CRM (pokazany w oknie „Telefon” w CRM)"
                android:textColor="#6C6878" />

            <EditText
                android:id="@+id/server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="np. https://crm.solid.pl"
                android:inputType="textUri"
                android:minHeight="56dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kod parowania (6 cyfr)"
                android:textColor="#6C6878" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="123 456"
                android:inputType="number"
                android:maxLength="7"
                android:minHeight="56dp"
                android:textSize="24sp" />

            <Button
                android:id="@+id/pair"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#2456D6"
                android:text="Połącz z CRM"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ready_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:backgroundTint="#16A34A"
                android:text="Uruchom dialer"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#6C6878" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Jak to działa: klikasz „Zadzwoń” w CRM na komputerze, telefon sam wybiera numer. Po rozmowie CRM dostaje informację, czy klient odebrał i ile trwała rozmowa. Aplikacja może być w tle – ważne, żeby było widać powiadomienie „Dialer gotowy do pracy”."
                android:textColor="#1D1B24" />

            <Button
                android:id="@+id/unpair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Odłącz od CRM" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
